DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=group12_app
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-secret

# Any OpenAI-compatible chat completions API works here. Leave AI_API_KEY empty
# to use the built-in local fallback instead of a real AI call.
# Example (Groq, free tier): AI_API_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# Example (OpenAI):         AI_API_BASE_URL=https://api.openai.com/v1/chat/completions
AI_API_BASE_URL=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
